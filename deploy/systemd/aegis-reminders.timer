[Unit]
Description=aegis: каждые 5 минут проверить, не пора ли что-нибудь напомнить

[Timer]
# 5 минут — компромисс между «опоздает» и «будит систему без дела». Точность не нужна:
# напоминание «в 9:00» на 9:03 лучше, чем гонка каждые 10 секунд
OnCalendar=*-*-* *:00/5:00
AccuracySec=30s
# сервер мог быть выключен ночь: догнать всё просроченное, а не «выбрать самое свежее».
# Потолок на количество задаёт REMINDERS_BATCH — остальное растянется по следующим проходам
Persistent=true
RandomizedDelaySec=20

[Install]
WantedBy=timers.target
