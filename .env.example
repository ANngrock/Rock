# ==== aegis: пример конфигурации ====
# cp .env.example .env && $EDITOR .env
ENV=dev

# --- Telegram ---
# @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# @userinfobot -> ваш числовой user_id. Единственный, кому бот отвечает.
TELEGRAM_OWNER_ID=
# необязательно: чат для алертов об ошибках (сначала /start боту, потом id со знаком минус)
TELEGRAM_ALERTS_CHAT_ID=

# --- Модели (OpenAI-совместимый API: z.ai напрямую или роутер) ---
# Ключ и адрес должны принадлежать ОДНОМУ сервису. Формат ключа выдаёт его с потрохами:
# <32 hex>.<16 символов> = z.ai/bigmodel, sk-or-v1-… = OpenRouter, sk-ai-v1-/sk-ss-v1-/sk-cs-v1-…
# = ZenMux (несмотря на «ai» в префиксе — это НЕ z.ai). Несовпадение = 401; бот сверяет ключ
# с хостом и говорит это прямо (в /status и в причине отказа).
GLM_API_KEY=
# OpenAI-совместимый базовый URL (без /chat/completions — клиент дописывает сам).
# z.ai: https://api.z.ai/api/paas/v4/ · OpenRouter: https://openrouter.ai/api/v1/ ·
# ZenMux: https://zenmux.ai/api/v1/ — у роутеров имена вида z-ai/glm-5.2 и свои цены
# (platform/gateway/models.py:PRICES, при расхождении цен ключ — "хост/имя").
# Внимание: у z.ai две несовместимые зоны — api.z.ai (международная) и open.bigmodel.cn (Китай),
# баланс и ключи между ними не переносятся (401/1000). Имена моделей тут без префикса автора.
GLM_BASE_URL=https://api.z.ai/api/paas/v4/
# Имена моделей можно переопределить без правки кода (пусто = каталог по умолчанию:
# glm-4.7-flash для текста и glm-4.6v-flash для картинок — оба бесплатные у z.ai, но не безлимитные:
# у них лимит частоты 1302/1303/1304). Платная brain-роль (например glm-5.2) возвращает
# дневной бюджет в осмысленное состояние.
# GLM-4.7-Flash и GLM-5.2 умеют только текст: MODEL_VISION обязан быть моделью из V-серии.
MODEL_BRAIN=
MODEL_VISION=
MODEL_FAST=
MODEL_EMBED=
# Отдельный эндпоинт для эмбеддингов (пусто = тот же GLM_BASE_URL и тот же ключ). Нужен, когда
# чат-роутер их не проксирует (у OpenRouter нет z-ai/embedding-3) или считает в разы дороже:
# тогда сюда — https://api.z.ai/api/paas/v4/ (или open.bigmodel.cn) и ключ z.ai.
EMBED_BASE_URL=
EMBED_API_KEY=
# Резервный провайдер (любой OpenAI-совместимый): включается при 5xx/лимите primary.
# Достаточно одного FALLBACK_MODEL — ключ и адрес берутся основные, дублировать секрет не нужно.
# Для бесплатной основной модели платный резерв обязателен: free-тиер режут по частоте (429).
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
FALLBACK_MODEL=
# false — если провайдер отвечает 400 на нестандартный параметр размышления (некоторые роутеры)
LLM_THINKING_PARAM=true
# Форма параметра: auto = по хосту (OpenRouter — reasoning.enabled, z.ai/bigmodel — thinking.type);
# zai|openrouter — задать вручную, если провайдер отвечает 400 («Reasoning is mandatory …»)
LLM_THINKING_STYLE=auto
# Глубина рассуждения brain-роли, если провайдер её принимает: low|medium|high|max (GLM 5.x).
# Пусто = не отправлять параметр. В trace попадает как есть — воспроизводимость не теряется.
# LLM_REASONING_EFFORT=

# --- Инфраструктура ---
# KV-бэкенд: redis (по умолчанию) | memory — только демо/CI/первый «пощупать».
# memory: история, pending-подтверждения и дневной бюджет живут лишь в этом процессе;
# с ENV=prod запрещён.
KV_BACKEND=redis
DATABASE_URL=postgresql+asyncpg://aegis:aegis@postgres:5432/aegis
REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222
# из контейнера бота поиск ходит на http://searxng:8080 (это задано в compose);
# это значение — для запуска прямо с хоста: 8888, порт опубликован на 127.0.0.1
SEARXNG_URL=http://localhost:8888
SEARXNG_SECRET=change-me-please

# --- Поиск и курсы (внешний мир) ---
# Порядок движков. searxng — self-hosted: запросы не уходят наружу. zai — web_search того же z.ai,
# что и модели: резерв на случай, когда Google режет IP датацентра (SearXNG тогда отвечает 200 и
# пустотой — «пусто» и «сломано» бот различает и говорит вслух).
SEARCH_ENGINES=searxng,zai
SEARCH_TIMEOUT_S=15
# «сегодня/курс/новости» сначала ищем за сутки, при пустом ответе — без окна
SEARCH_FRESHNESS_FIRST=true
SEARCH_REFINE=true
# движок z.ai и его адрес (пусто = GLM_BASE_URL); цена вызова — если провайдер её выставляет
SEARCH_ZAI_ENGINE=search-prime
SEARCH_ZAI_BASE_URL=
SEARCH_COST_USD_PER_CALL=0
# Курсы валют — детерминированный путь без LLM: источники без ключей, числа сверяются между собой
RATE_SOURCES=privatbank,nbu,erapi
RATE_HOME_CURRENCY=UAH
RATE_TOLERANCE_PCT=1.5
RATE_CACHE_TTL_S=300
RATES_TIMEOUT_S=10

# --- Политика/деньги/приватность ---
TIMEZONE=Europe/Moscow
BASE_CURRENCY=RUB
DAILY_BUDGET_USD=2.0
AUTO_ALLOW_LOW_RISK=true
# TTL ожидания подтверждения владельцем действия
PENDING_TTL_SECONDS=3600

# --- Наблюдаемость ---
LOG_LEVEL=INFO
LOG_JSON=true
# Langfuse подключается на шаге 2
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
