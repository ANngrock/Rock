# ==== aegis: пример конфигурации ====
# cp .env.example .env && $EDITOR .env
ENV=dev

# --- Telegram ---
# @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# @userinfobot -> ваш числовой user_id. Единственный, кому бот отвечает.
TELEGRAM_OWNER_ID=
# необязательно: чат для алертов об ошибках (сначала /start боту, потом id со знаком минус)
TELEGRAM_ALERTS_CHAT_ID=

# живой ответ: черновик правится на месте вместо ожидания всего ответа (по умолчанию выключено —
# у Telegram редактирования идут в общий лимит чата, и на медленном провайдере это шумнее, чем быстрее)
STREAM_REPLIES=false
# как часто править черновик, мс (не ниже 200)
STREAM_EDIT_INTERVAL_MS=900

# --- Outbox → NATS (aegis outbox tick / aegis-outbox.timer) ---
# выключено по умолчанию: NATS поднимается профилем `durable` (docker compose --profile durable
# up -d nats). Пока relay выключен, события копятся в platform.outbox и не теряются
OUTBOX_RELAY_ENABLED=false
# событий за один тик
OUTBOX_BATCH=50
# после скольких неудач строка перестаёт выбираться (останется в очереди до починки)
OUTBOX_MAX_ATTEMPTS=8
# JetStream-стрим и префикс субъектов; стрим создаётся вручную (nats stream add), см. RUNBOOK
NATS_STREAM=aegis_events
NATS_SUBJECT_PREFIX=aegis
# секунд на коннект: тик не должен висеть, когда брокер не поднят (NATS_URL — в секции инфраструктуры)
NATS_CONNECT_TIMEOUT_S=3

# --- Экспорт журнала в Langfuse (aegis export langfuse / aegis-export.timer) ---
# выключено по умолчанию: витрина наблюдения не обязательна, а ключи уезжают наружу
LANGFUSE_ENABLED=false
# базовый адрес без пути: облако (https://cloud.langfuse.com) или self-hosted (http://langfuse:3000)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# окно перечитывания журнала: повтор безопасен — id спанов выводятся из записей, а не из случайности
LANGFUSE_WINDOW_HOURS=24
LANGFUSE_LIMIT=500
# символов input/output в спане (полное содержимое остаётся в platform.blobs)
LANGFUSE_MAX_CHARS=6000
LANGFUSE_TIMEOUT_S=10

# --- Индексация заметок (aegis index notes / aegis-index.timer) ---
# заметок за один проход; очередь длиннее — останется на следующий
EMBED_INDEX_LIMIT=200
# текстов в одном запросе к /embeddings
EMBED_BATCH_SIZE=32
# сколько символов заметки уходит в эмбеддинг (хвост отрезается, начало важнее)
EMBED_MAX_CHARS=2000

# --- Модели (OpenAI-совместимый API: z.ai напрямую или роутер) ---
# Ключ и адрес должны принадлежать ОДНОМУ сервису. Формат ключа выдаёт его с потрохами:
# <32 hex>.<16 символов> = z.ai/bigmodel, sk-or-v1-… = OpenRouter, sk-ai-v1-/sk-ss-v1-/sk-cs-v1-…
# = ZenMux (несмотря на «ai» в префиксе — это НЕ z.ai). Несовпадение = 401; бот сверяет ключ
# с хостом и говорит это прямо (в /status и в причине отказа).
GLM_API_KEY=
# OpenAI-совместимый базовый URL (без /chat/completions — клиент дописывает сам).
# z.ai: https://api.z.ai/api/paas/v4/ · OpenRouter: https://openrouter.ai/api/v1/ ·
# ZenMux: https://zenmux.ai/api/v1/ — у роутеров имена вида z-ai/glm-5.2 и свои цены
# (platform/gateway/models.py:PRICES, при расхождении цен ключ — "хост/имя").
# Внимание: у z.ai две несовместимые зоны — api.z.ai (международная) и open.bigmodel.cn (Китай),
# баланс и ключи между ними не переносятся (401/1000). Имена моделей тут без префикса автора.
GLM_BASE_URL=https://api.z.ai/api/paas/v4/
# Имена моделей можно переопределить без правки кода (пусто = каталог по умолчанию:
# glm-4.7-flash для текста и glm-4.6v-flash для картинок — оба бесплатные у z.ai, но не безлимитные:
# у них лимит частоты 1302/1303/1304). Платная brain-роль (например glm-5.2) возвращает
# дневной бюджет в осмысленное состояние.
# GLM-4.7-Flash и GLM-5.2 умеют только текст: MODEL_VISION обязан быть моделью из V-серии.
MODEL_BRAIN=
MODEL_VISION=
MODEL_FAST=
MODEL_EMBED=
# Отдельный эндпоинт для эмбеддингов (пусто = тот же GLM_BASE_URL и тот же ключ). Нужен, когда
# чат-роутер их не проксирует (у OpenRouter нет z-ai/embedding-3) или считает в разы дороже:
# тогда сюда — https://api.z.ai/api/paas/v4/ (или open.bigmodel.cn) и ключ z.ai.
EMBED_BASE_URL=
EMBED_API_KEY=
# Резервный провайдер (любой OpenAI-совместимый): включается при 5xx/лимите primary.
# Достаточно одного FALLBACK_MODEL — ключ и адрес берутся основные, дублировать секрет не нужно.
# Для бесплатной основной модели платный резерв обязателен: free-тиер режут по частоте (429).
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
FALLBACK_MODEL=
# false — если провайдер отвечает 400 на нестандартный параметр размышления (некоторые роутеры)
LLM_THINKING_PARAM=true
# Форма параметра: auto = по хосту (OpenRouter — reasoning.enabled, z.ai/bigmodel — thinking.type);
# zai|openrouter — задать вручную, если провайдер отвечает 400 («Reasoning is mandatory …»)
LLM_THINKING_STYLE=auto
# Глубина рассуждения brain-роли, если провайдер её принимает: low|medium|high|max (GLM 5.x).
# Пусто = не отправлять параметр. В trace попадает как есть — воспроизводимость не теряется.
# LLM_REASONING_EFFORT=

# --- Инфраструктура ---
# KV-бэкенд: redis (по умолчанию) | memory — только демо/CI/первый «пощупать».
# memory: история, pending-подтверждения и дневной бюджет живут лишь в этом процессе;
# с ENV=prod запрещён.
KV_BACKEND=redis
DATABASE_URL=postgresql+asyncpg://aegis:aegis@postgres:5432/aegis
REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222
# пул соединений: 10 хватает на бота + cron-якорь; больше — только если появятся worker'ы
DB_POOL_SIZE=10
# размерность эмбеддингов модели: не «настройка по вкусу», а свойство модели (иначе индекс и
# вставка разойдутся). 2048 = embedding-3 у z.ai; ANN-индекс PG работает до 2000 измерений,
# поэтому поиск по вектору идёт точным (exact) порядком, и это осознанно задокументировано
EMBEDDING_DIMS=2048
# из контейнера бота поиск ходит на http://searxng:8080 (это задано в compose);
# это значение — для запуска прямо с хоста: 8888, порт опубликован на 127.0.0.1
SEARXNG_URL=http://localhost:8888
SEARXNG_SECRET=change-me-please

# --- Поиск и курсы (внешний мир) ---
# Порядок движков. searxng — self-hosted: запросы не уходят наружу. zai — web_search того же z.ai,
# что и модели: резерв на случай, когда Google режет IP датацентра (SearXNG тогда отвечает 200 и
# пустотой — «пусто» и «сломано» бот различает и говорит вслух).
SEARCH_ENGINES=searxng,zai
SEARCH_TIMEOUT_S=15
# SearXNG живёт в том же стеке: таймаут отдельно, потому что «движок думает 25 секунд» и
# «движка нет» для владельца должны различаться по-разному
SEARXNG_TIMEOUT_S=20
# «сегодня/курс/новости» сначала ищем за сутки, при пустом ответе — без окна
SEARCH_FRESHNESS_FIRST=true
SEARCH_REFINE=true
# движок z.ai и его адрес (пусто = GLM_BASE_URL); цена вызова — если провайдер её выставляет
SEARCH_ZAI_ENGINE=search-prime
SEARCH_ZAI_BASE_URL=
SEARCH_COST_USD_PER_CALL=0
# Курсы валют — детерминированный путь без LLM: источники без ключей, числа сверяются между собой
RATE_SOURCES=privatbank,nbu,erapi
RATE_HOME_CURRENCY=UAH
RATE_TOLERANCE_PCT=1.5
RATE_CACHE_TTL_S=300
RATES_TIMEOUT_S=10

# --- Контекст, вложения, страницы ---
# сколько реплик диалога подмешивать (в БД ничего не «доучивается»: контекст = история в KV)
HISTORY_LIMIT=30
HISTORY_TTL_SECONDS=86400
# цикл агента: 8 итераций — потолок «модель зовёт инструменты», а не пожелание
MAX_ITERATIONS=8
# vision: перед отправкой в модель фото урезается по длинной стороне и пережимается в JPEG —
# 1568 это ровно потолок, при котором GLM не режет детали сетки патча
IMAGE_MAX_SIDE=1568
IMAGE_JPEG_QUALITY=85
# чтение страниц: сколько текста отдавать модели и можно ли ходить во внутренние сети
FETCH_MAX_CHARS=6000
FETCH_TIMEOUT_S=25
# false = SSRF-защита: 127.0.0.1, 10/8, 169.254.169.254 не читаются. Включать только если
# действительно нужен внутренний дашборд, и тогда — осознанно
FETCH_ALLOW_PRIVATE=false
# транспорт моделей: таймаут, повторы на клиента, пауза между попытками
LLM_TIMEOUT_S=60
LLM_RETRIES_PER_CLIENT=2
LLM_BACKOFF_S=1.5

# --- Политика/деньги/приватность ---
TIMEZONE=Europe/Moscow
BASE_CURRENCY=RUB
DAILY_BUDGET_USD=2.0
AUTO_ALLOW_LOW_RISK=true
# TTL ожидания подтверждения владельцем действия
PENDING_TTL_SECONDS=3600

# --- Воспроизводимость (M1) ---
# журнал решений: точные промпты, ответы, вызовы инструментов и решения policy — в хэш-цепочке.
# Выключить можно, но тогда «почему ты тогда так ответил» и /replay работать не будут (бот честно
# это скажет, а не начнёт догадываться).
REPRO_ENABLED=true
# писать ли содержимое запросов/ответов в blobs. false экономит диск, но ход перестаёт быть
# воспроизводимым целиком: остаются метрики и хэши
REPRO_RECORD_PAYLOAD=true
# потолок на один блоб: сверх него содержимое усекается и запись помечается truncated — молча
# обрезать «то, что модель видела» нельзя, усечение видно в aegis repro verify и в объяснении хода
REPRO_MAX_BLOB_BYTES=1048576
# сколько записей сверять за один проход verify (cron-проверка целостности)
REPRO_VERIFY_LIMIT=5000
# якорь дня (мерклов корень записей) ставится вне бота — cron/systemd-timer:
#   0 3 * * * cd /srv/aegis && docker compose -f deploy/docker-compose.yml run --rm bot aegis repro anchor
# опубликованный root (git tag, письмо себе, любая дата-верификация) делает правку журнала заметной

# --- Проверка ответов и карантин (шаг 2) ---
# ответ сверяется с результатами инструментов: числа и даты, которых нет в источниках, помечаются
# владельцу отдельной строкой ⚠️ — пересказывать чужую ошибку модель не обязана
VERIFY_ENABLED=true
# сверять и ответы без чисел: выдуманный «качественный» факт числами не ловится, только судьёй
VERIFY_ALWAYS=false
# короткие ответы не проверяем: сверять нечего, а платный вызов будет
VERIFY_MIN_ANSWER_CHARS=200
# сколько источников отдавать судье (по 3000 знаков на каждый)
VERIFY_MAX_SOURCES=6
# внешний текст размечает отдельная модель (dual-LLM): планировщик видит структуру, а не страницу,
# и попытки страницы «командовать ассистентом» доходят до владельца как данные, а не как указания
QUARANTINE_ENABLED=true
# короче этого размечать дороже, чем читать: строка курса не требует карантина
QUARANTINE_MIN_CHARS=600
# сколько сырых знаков отдаётся карантину — защита от «перескажи мне весь интернет»
QUARANTINE_MAX_CHARS=24000
# модель карантина; пусто = дешёвая роль по умолчанию. Сюда же уводят локальную модель, если чужой
# текст вообще не должен уходить наружу
MODEL_QUARANTINE=

# --- Напоминания ---
# инструмент постановки напоминаний; false = «не могу», а не «пообещаю и промолчу»
REMINDERS_ENABLED=true
# сколько напоминаний отправляет один тик таймера (остальное — в следующем проходе)
REMINDERS_BATCH=20
# как часто расписание продвигает сам процесс бота (0 = только systemd-таймер, ±5 минут;
# 60 = тик раз в минуту — ровно то, что нужно звонку «в 15:00»)
REMINDERS_INPROCESS_SECONDS=60

# --- Звонок как канал напоминаний ---
# none|twilio|webhook: twilio = TTS через REST без публичного URL (TwiML в теле запроса),
# webhook = POST {"to","text"} на свой телефонный шлюз (Asterisk/FreePBX)
CALL_PROVIDER=none
# телефон владельца в E.164; из конфига, а не из фразы чата (защита от «позвони на любой номер»)
NOTIFY_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CALL_WEBHOOK_URL=
# сколько ждать принятия звонка провайдером (не длительность разговора)
CALL_TIMEOUT_SECONDS=12

# --- Наблюдаемость ---
LOG_LEVEL=INFO
LOG_JSON=true
# Langfuse подключается на шаге 2
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Параллельность хода (F1) ---
# аренда активного хода; просроченную забирает следующий процесс (v2 crash-recovery в один слой)
TURN_LEASE_MINUTES=15
# сколько сообщений из очереди «один ход на владельца» разбирается после финала хода
TURN_DRAIN_LIMIT=3

# --- Принципалы и границы данных (F2) ---
# «42:member,77:guest» — постоянные пользователи, кроме владельца; владелец — ADMIN_ID
PRINCIPAL_ROSTER=
# роль под RLS; superuser обходит политики, и doctor показывает, если подключен не тот role
RLS_EXPECTED_ROLE=aegis_app

# --- Конвертовое шифрование (F3) ---
# off — не шифровать (dev/тесты); auto — шифровать при ключе; enforce — без ключа не стартуем
CRYPTO_MODE=auto
# base64 от 32 байт. Старые версии для чтения — AEGIS_KEK_V1..V<N>; в БД ключи не лежат нигде
CRYPTO_KEK=
CRYPTO_KEY_VERSION=1
# сколько блобов перекрывается фоновым тиком ротации (аренда как у напоминаний)
REWRAP_BATCH=200

# --- Policy как код (F5) ---
# декларативные правила; lock — зафиксированный digest для CI («файл ≠ запертый» = красный)
POLICY_RULES_PATH=deploy/policy/rules.yml
POLICY_LOCK_PATH=deploy/policy/rules.lock.json

# --- Флаги (F6) ---
# флаг на 100% дольше N дней обязан быть удалён (CI-hygiene)
FLAG_STALE_DAYS=90
# TTL кеша определителей флагов, секунд
FLAGS_CACHE_S=30

# --- SLO и деградация (F7) ---
SLO_PATH=deploy/slo.yml
# окна для burn-rate: короткое=1/12 long, длинное=SLO_WINDOW_MINUTES
SLO_WINDOW_MINUTES=60
# включать ли автоматическое переключение поведения при провале бюджета
SLO_ENFORCE_DEGRADATION=true
# как часто процесс пишет снапшот метрик в platform.metric_samples (секунды)
METRICS_FLUSH_SECONDS=30
# TTL автоматических переключателей деградации: «галочка без expiry» = деградация навсегда
DEGRADATION_TTL_SECONDS=900

# --- retention-as-code (F3) ---
# политики хранения: категории, окна, grace; legal hold перекрывает всё
RETENTION_FILE=deploy/retention.yml

# --- Воркфлоу хода (F8) ---
# off — «отсутствующий Temporal» есть норма; local — локальный раннер с activity-id; temporal — сервер
WORKFLOW_MODE=off
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=aegis

# --- Поиск по заметкам (F9) ---
# кандидатов на каждую ветку (lexical/vector) до reciprocal-rank fusion
SEARCH_CANDIDATES=40
# сколько верхних результатов проходит реранк (не «весь список»)
RERANK_LIMIT=20
# off | lexical (детерминированный) | model (судья на LLM — дорого)
RERANK_MODE=lexical
# константа RRF: 60 — из оригинальной статьи; менять «просто так» нельзя
RRF_K=60
